// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PerfilUsuario {
  PROPRIETARIO
  FUNCIONARIO
  CLIENTE
}

enum StatusOrdemServico {
  AGUARDANDO
  EM_EXECUCAO
  CONCLUIDO
  ENTREGUE
  CANCELADO
}

enum StatusAgendamento {
  PENDENTE
  CONFIRMADO
  CANCELADO
}

enum TipoItemOS {
  PECA
  MAO_DE_OBRA
}

enum StatusPagamento {
  PENDENTE
  PAGO
  CANCELADO
}

model Usuario {
  id         String        @id @default(uuid())
  nome       String
  email      String        @unique
  senhaHash  String
  perfil     PerfilUsuario
  ativo      Boolean       @default(true)
  criadoEm   DateTime      @default(now())
  cliente    Cliente?
  ordensServico OrdemServico[] @relation("FuncionarioResponsavel")
}

model Cliente {
  id        String    @id @default(uuid())
  usuarioId String?   @unique
  usuario   Usuario?  @relation(fields: [usuarioId], references: [id])
  nome      String
  telefone  String?
  email     String?
  documento String?
  criadoEm  DateTime  @default(now())
  veiculos      Veiculo[]
  agendamentos  Agendamento[]
}

model Veiculo {
  id        String   @id @default(uuid())
  clienteId String
  cliente   Cliente  @relation(fields: [clienteId], references: [id])
  placa     String   @unique
  marca     String
  modelo    String
  ano       Int?
  kmAtual   Int?
  criadoEm  DateTime @default(now())
  ordensServico OrdemServico[]
  agendamentos  Agendamento[]
}

model OrdemServico {
  id                    String              @id @default(uuid())
  veiculoId             String
  veiculo               Veiculo             @relation(fields: [veiculoId], references: [id])
  funcionarioId         String?
  funcionario           Usuario?            @relation("FuncionarioResponsavel", fields: [funcionarioId], references: [id])
  dataAbertura          DateTime            @default(now())
  dataEntregaPrevista   DateTime?
  status                StatusOrdemServico  @default(AGUARDANDO)
  descricaoProblema     String?
  valorTotal            Decimal             @default(0) @db.Decimal(10, 2)
  itens         ItemOrdemServico[]
  agendamento   Agendamento?
  pagamentos    Pagamento[]
}

model ItemOrdemServico {
  id              String        @id @default(uuid())
  ordemServicoId  String
  ordemServico    OrdemServico  @relation(fields: [ordemServicoId], references: [id])
  tipo            TipoItemOS
  pecaId          String?
  peca            Peca?         @relation(fields: [pecaId], references: [id])
  descricao       String
  quantidade      Int           @default(1)
  valorUnitario   Decimal       @db.Decimal(10, 2)
}

model Agendamento {
  id              String            @id @default(uuid())
  clienteId       String
  cliente         Cliente           @relation(fields: [clienteId], references: [id])
  veiculoId       String
  veiculo         Veiculo           @relation(fields: [veiculoId], references: [id])
  dataHora        DateTime
  status          StatusAgendamento @default(PENDENTE)
  ordemServicoId  String?           @unique
  ordemServico    OrdemServico?     @relation(fields: [ordemServicoId], references: [id])
  criadoEm        DateTime          @default(now())
}

model Peca {
  id                  String   @id @default(uuid())
  nome                String
  sku                 String?  @unique
  quantidadeEstoque   Int      @default(0)
  quantidadeMinima    Int      @default(0)
  valorCusto          Decimal  @db.Decimal(10, 2)
  valorVenda          Decimal  @db.Decimal(10, 2)
  fornecedorId        String?
  fornecedor          Fornecedor? @relation(fields: [fornecedorId], references: [id])
  itensOS     ItemOrdemServico[]
  gastos      Gasto[]
}

model Fornecedor {
  id       String  @id @default(uuid())
  nome     String
  contato  String?
  pecas    Peca[]
  gastos   Gasto[]
}

model Gasto {
  id            String      @id @default(uuid())
  categoria     String
  descricao     String?
  valor         Decimal     @db.Decimal(10, 2)
  data          DateTime    @default(now())
  fornecedorId  String?
  fornecedor    Fornecedor? @relation(fields: [fornecedorId], references: [id])
  pecaId        String?
  peca          Peca?       @relation(fields: [pecaId], references: [id])
}

model Pagamento {
  id              String          @id @default(uuid())
  ordemServicoId  String
  ordemServico    OrdemServico    @relation(fields: [ordemServicoId], references: [id])
  valor           Decimal         @db.Decimal(10, 2)
  formaPagamento  String
  data            DateTime        @default(now())
  status          StatusPagamento @default(PENDENTE)
}